# Copy this file to ".env" only if you build on your own computer.
# For GitHub builds, add these two values as repository secrets instead
# (Settings → Secrets and variables → Actions → New repository secret).
#
# Both values are PUBLIC by design: Supabase protects your data with the
# row-level security rules in supabase/migrations. Find them in Supabase:
# Project Settings → API (or "Connect" → App Frameworks).
#
# NEVER put the service_role key, a "sb_secret_..." key, or your database
# password here. The build refuses to run if it finds one.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
